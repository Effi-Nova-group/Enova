---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const thankYouUrl = new URL('/thank-you', Astro.site).href;
---
<BaseLayout
  title="Enova | Next-Gen Digital Agency"
  description="Enova drives your business growth with high-performing, affordable digital solutions, backed by a 100% performance-based model."
>
  <div></div>
  <main class="seaction-header-main">
    <div id="canvas" class="canvas"></div>
    <div class="header_background-image hero-video-frame">
      <video
        id="hero-video"
        class="hero-video-frame__video"
        src="/videos/hero-video.mp4"
        poster="/videos/hero-video-poster.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      ></video>
      <button type="button" id="hero-video-mute-toggle" class="hero-video-mute-toggle" aria-pressed="true" aria-label="Unmute video">
        <svg class="hero-video-mute-toggle__icon hero-video-mute-toggle__icon--muted" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 9v6h4l5 5V4L8 9H4Z" fill="currentColor"/>
          <path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <svg class="hero-video-mute-toggle__icon hero-video-mute-toggle__icon--unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 9v6h4l5 5V4L8 9H4Z" fill="currentColor"/>
          <path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="hero-content">
      <h1 class="hero-content__headline">Enova drives your <em>business growth</em></h1>
      <div class="button-primary-gradient hero-content__cta">
        <a href="#contact" class="button-primary small-v2 w-button">Book Your Free Strategy Call</a>
      </div>
    </div>
  </main>

  <section class="section cta-callout">
    <div class="cta-callout__inner">
      <p class="cta-callout__lead">Enova drives your business growth with high-performing, affordable digital solutions, backed by a 100% performance-based model.</p>
      <h2 class="cta-callout__headline">High-Impact Web &amp; AI Marketing. <em>Zero Risk.</em></h2>
      <div class="cta-callout__body">
        <p>Most agencies charge massive retainers, regardless of whether you make money. We do things differently.</p>
        <p>At Enova, we tie our success directly to yours through an advanced, AI-powered, performance-based digital marketing model. If we don't deliver results, you don't pay.</p>
      </div>
      <div class="cta-callout__action">
        <div class="button-primary-gradient header-button">
          <a href="#contact" class="button-primary small-v2 w-button">Book Your Free Strategy Call</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section services services-full">
    <div class="services-t5">
      <header class="section-intro">
        <h2 class="section-intro__heading">What We <em>Do</em></h2>
      </header>
      <article class="edito">
        <h3 class="edito__title">Affordable Web Design <em>&amp; Development</em></h3>
        <p class="edito__lead">Get a stunning, fast, and secure website without the enterprise price tag. We build high-converting digital spaces designed to turn casual visitors into loyal customers.</p>
        <div class="edito__body edito__body--two">
          <div class="edito__group">
            <h4>Affordable eCommerce Web Design</h4>
            <p>Fully optimized online stores built to maximize checkouts, minimize cart abandonment, and scale your sales.</p>
          </div>
          <div class="edito__group">
            <h4>Custom Web Design</h4>
            <p>Unique, tailor-made digital experiences crafted around your brand identity and business goals.</p>
          </div>
        </div>
      </article>
      <div class="edito-row">
        <article class="edito">
          <h3 class="edito__title">App <em>Development</em></h3>
          <p class="edito__lead">Bring your vision to mobile screens. We design and build seamless, intuitive iOS and Android applications that engage users and streamline your business operations.</p>
        </article>
        <article class="edito">
          <h3 class="edito__title">Advanced AI <em>Digital Marketing</em></h3>
          <p class="edito__lead">Supercharge your customer acquisition. We leverage cutting-edge artificial intelligence to optimize your ad spend, target high-intent buyers, and predict market trends in real time.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section services services-full">
    <div class="services-t5">
      <article class="edito">
        <header class="section-intro">
          <h2 class="section-intro__heading">Why Choose <em>Enova?</em></h2>
        </header>
        <div class="edito__body">
          <div class="edito__group">
            <h4>Performance-Based Model</h4>
            <p>You only pay for measurable business growth and real performance metrics.</p>
          </div>
          <div class="edito__group">
            <h4>Affordable Excellence</h4>
            <p>Premium design, development, and marketing strategies scaled to fit your budget.</p>
          </div>
          <div class="edito__group">
            <h4>AI-Driven Data</h4>
            <p>No guessing games—our advanced AI tools ensure your marketing dollars reach the right audience.</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section blog-preview">
    <div class="blog-preview__container">
      <div class="blog-preview__header">
        <div>
          <p class="blog-preview__eyebrow">From the blog</p>
          <h2 class="blog-preview__heading">Latest <em>thinking.</em></h2>
        </div>
        <a href="/blog" class="blog-preview__view-all">View all articles →</a>
      </div>
      <div class="blog-preview__grid">
        <a href="/blog/enterprise-digital-vision" class="home-blog-card is-hero">
          <div class="home-blog-card__image" style="background-image:url('/Gemini_Generated_Image_msmm7fmsmm7fmsmm.jpeg');background-size:cover;background-position:center;"></div>
          <div class="home-blog-card__body">
            <p class="home-blog-card__eyebrow">Digital transformation</p>
            <h3 class="home-blog-card__title">Framing the Future: How to Define a Scalable Enterprise Digital Vision</h3>
            <p class="home-blog-card__excerpt">Enterprise transformation rarely fails on technology. It fails on vision. Here's how to benchmark maturity and build a case that boards trust.</p>
            <span class="home-blog-card__more">Read article →</span>
          </div>
        </a>
        <a href="/blog/magento-open-source" class="home-blog-card">
          <div class="home-blog-card__image" style="background-image:url('/Gemini_Generated_Image_sga7q9sga7q9sga7.jpeg');background-size:cover;background-position:center;"></div>
          <div class="home-blog-card__body">
            <p class="home-blog-card__eyebrow">Digital experience</p>
            <h3 class="home-blog-card__title">Open-Source Flexibility: Maximizing ROI with Enterprise Magento Solutions</h3>
            <span class="home-blog-card__more">Read article →</span>
          </div>
        </a>
        <a href="/blog/custom-mobile-app-development" class="home-blog-card">
          <div class="home-blog-card__image" style="background-image:url('/Gemini_Generated_Image_5r999o5r999o5r99.jpeg');background-size:cover;background-position:center;"></div>
          <div class="home-blog-card__body">
            <p class="home-blog-card__eyebrow">Digital innovation</p>
            <h3 class="home-blog-card__title">From Concept to Code: Navigating Custom Mobile Application Development</h3>
            <span class="home-blog-card__more">Read article →</span>
          </div>
        </a>
        <a href="/blog/integrated-martech-analytics" class="home-blog-card is-wide">
          <div class="home-blog-card__image" style="background-image:url('/Gemini_Generated_Image_lnplzllnplzllnpl.jpeg');background-size:cover;background-position:center;"></div>
          <div class="home-blog-card__body">
            <p class="home-blog-card__eyebrow">Digital experience</p>
            <h3 class="home-blog-card__title">Unlocking Data Value: Building an Integrated MarTech and Analytics Ecosystem</h3>
            <p class="home-blog-card__excerpt">Fragmented tools waste budget and blur attribution. A unified MarTech and analytics stack turns raw data into measurable revenue.</p>
            <span class="home-blog-card__more">Read article →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section clients">
    <div class="clients-marquee" aria-label="Trusted by leading brands">
      <div class="clients-marquee-track">
        <div class="clients-marquee-group" aria-hidden="false">
          <img src="/deloitte%201.png" alt="Deloitte">
          <img src="/Gartner_logo.svg%201.png" alt="Gartner">
          <img src="/porche%201.png" alt="Porsche">
          <img src="/GNC_Logo.svg%201.png" alt="GNC">
          <img src="/LV%201.png" alt="LV">
          <img src="/Winnings-mono-logo-2022_JS%201.png" alt="Winning Group">
          <img src="/appliances%20logo%201.png" alt="Appliances Online">
        </div>
        <div class="clients-marquee-group" aria-hidden="true">
          <img src="/deloitte%201.png" alt="">
          <img src="/Gartner_logo.svg%201.png" alt="">
          <img src="/porche%201.png" alt="">
          <img src="/GNC_Logo.svg%201.png" alt="">
          <img src="/LV%201.png" alt="">
          <img src="/Winnings-mono-logo-2022_JS%201.png" alt="">
          <img src="/appliances%20logo%201.png" alt="">
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section_contact">
    <div class="padding-global-4">
      <div class="container-large-3">
        <div class="padding-section-large-3">
          <div class="contact_component">
            <div class="w-layout-grid contact_content">
              <div class="contact_content-left">
                <div class="margin-bottom margin-medium">
                  <div class="contact_heading-wrapper">
                    <div class="margin-bottom margin-small">
                      <h2 class="heading-style-h2-2">Let's start a <em>conversation.</em></h2>
                    </div>
                  </div>
                </div>
                <div class="contact-phone-lockup">
                  <span class="contact-phone-eyebrow">Toll-free</span>
                  <a href="tel:1300926895">1 300 926 895</a>
                </div>
              </div>
              <div class="contact5_form_component strategy-form-wrapper">
                <form id="strategy-form" class="strategy-form" action="https://api.web3forms.com/submit" method="POST" enctype="multipart/form-data" novalidate>
                  <input type="hidden" name="access_key" value="6849b585-b4aa-4230-aedf-02b3d93410d4">
                  <input type="hidden" name="subject" value="New Strategy Call Request — Enova">
                  <input type="hidden" name="from_name" value="Enova Website">
                  <input type="hidden" name="redirect" value={thankYouUrl}>
                  <input type="checkbox" name="botcheck" class="strategy-form__botcheck" tabindex="-1" autocomplete="off">
                  <div class="strategy-form__row">
                    <label class="strategy-form__field">
                      <span>First Name<span class="strategy-form__required">*</span></span>
                      <input type="text" name="first_name" autocomplete="given-name" required>
                    </label>
                    <label class="strategy-form__field">
                      <span>Last Name<span class="strategy-form__required">*</span></span>
                      <input type="text" name="last_name" autocomplete="family-name" required>
                    </label>
                  </div>
                  <label class="strategy-form__field">
                    <span>Business Email<span class="strategy-form__required">*</span></span>
                    <input type="email" name="email" autocomplete="email" required>
                  </label>
                  <label class="strategy-form__field">
                    <span>Company Name<span class="strategy-form__required">*</span></span>
                    <input type="text" name="company" autocomplete="organization" required>
                  </label>
                  <label class="strategy-form__field">
                    <span>Phone Number<span class="strategy-form__required">*</span></span>
                    <input type="tel" name="phone" autocomplete="tel" required>
                  </label>
                  <div class="button-primary-gradient header-button strategy-form__submit-wrap">
                    <button type="submit" class="button-primary small-v2 w-button strategy-form__submit">Book a Strategy Call</button>
                  </div>
                  <p id="strategy-form-result" class="strategy-form__result" aria-live="polite"></p>
                </form>
                <script is:inline>
                  (function () {
                    var form = document.getElementById('strategy-form');
                    var result = document.getElementById('strategy-form-result');
                    if (!form || !result) return;
                    form.addEventListener('submit', async function (e) {
                      e.preventDefault();
                      if (form.botcheck && form.botcheck.checked) return;
                      var submit = form.querySelector('.strategy-form__submit');
                      submit.disabled = true;
                      result.textContent = 'Sending…';
                      result.className = 'strategy-form__result';
                      try {
                        var response = await fetch('https://api.web3forms.com/submit', {
                          method: 'POST',
                          body: new FormData(form)
                        });
                        var data = await response.json();
                        if (data.success) {
                          result.textContent = "Thanks — we'll be in touch shortly.";
                          result.className = 'strategy-form__result is-success';
                          form.reset();
                          window.location.href = '/thank-you';
                        } else {
                          result.textContent = data.message || 'Something went wrong. Please try again.';
                          result.className = 'strategy-form__result is-error';
                        }
                      } catch (err) {
                        result.textContent = 'Network error. Please try again.';
                        result.className = 'strategy-form__result is-error';
                      } finally {
                        submit.disabled = false;
                      }
                    });
                  })();
                </script>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <script is:inline>
    (function () {
      var video = document.getElementById('hero-video');
      var toggle = document.getElementById('hero-video-mute-toggle');
      if (!video || !toggle) return;

      function updateToggleState() {
        toggle.setAttribute('aria-pressed', String(video.muted));
        toggle.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
        toggle.classList.toggle('is-muted', video.muted);
      }

      toggle.addEventListener('click', function () {
        video.muted = !video.muted;
        updateToggleState();
      });

      updateToggleState();

      function reveal() {
        video.classList.add('is-ready');
        toggle.classList.add('is-visible');
      }

      if (video.readyState >= 2) {
        reveal();
      } else {
        video.addEventListener('loadeddata', reveal, { once: true });
      }
    })();
  </script>
  <script is:inline>
    (function () {
      var container = document.querySelector('.clients-marquee');
      var track = document.querySelector('.clients-marquee-track');
      if (!container || !track) return;
      var groups = track.querySelectorAll('.clients-marquee-group');
      if (!groups.length) return;
      var originalGroup = groups[0];
      function ensureFill() {
        var target = container.offsetWidth * 3;
        var safety = 0;
        while (track.scrollWidth < target && safety < 20) {
          var clone = originalGroup.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.querySelectorAll('img').forEach(function(img){ img.setAttribute('alt',''); });
          track.appendChild(clone);
          safety++;
        }
        var half = Math.round(track.scrollWidth / 2);
        track.style.setProperty('--marquee-shift', '-' + half + 'px');
        var duration = Math.max(20, Math.round(half / 90));
        track.style.setProperty('--marquee-duration', duration + 's');
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', ensureFill);
      } else {
        ensureFill();
      }
      window.addEventListener('load', ensureFill);
      var rt;
      window.addEventListener('resize', function () {
        clearTimeout(rt);
        rt = setTimeout(ensureFill, 150);
      });
    })();
  </script>
</BaseLayout>
