---
import Nav from '../components/Nav.astro';
import '../styles/site.css';
import '../styles/blog.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  bodyClass?: string;
  noIndex?: boolean;
  jsonLd?: object;
}

const {
  title,
  description,
  ogImage = '/enova-favicon.png',
  ogType = 'website',
  bodyClass = 'body',
  noIndex = false,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site?.href ?? 'https://enova.pages.dev/';
// Strip .html and /index.html so canonicals match the sitemap and Cloudflare's
// clean URLs (e.g. /blog/foo instead of /blog/foo.html).
const cleanPath = (
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
) || '/';
const canonicalUrl = new URL(cleanPath, siteUrl).href;
const absoluteOgImage = new URL(ogImage, siteUrl).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Enova',
  url: siteUrl,
  logo: new URL('/enova-favicon.png', siteUrl).href,
  description:
    "Enova is an award-winning digital agency helping brands drive growth through digital transformation, customer experience, and innovation.",
  sameAs: ['https://github.com/Effi-Nova-group/Enova'],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+61-1300-926-895',
    contactType: 'customer service',
    areaServed: 'AU',
    availableLanguage: 'English',
  },
};
---
<!DOCTYPE html>
<html lang="en" data-wf-page="6a576e7c50f1df5088dda2f5" data-wf-site="6a576e7b50f1df5088dda25d">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta content="width=device-width, initial-scale=1" name="viewport" />
  <meta content="Webflow" name="generator" />
  <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta name="theme-color" content="#0d0f14" />

  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Enova" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:url" content={canonicalUrl} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />

  <link href="/css/normalize.css" rel="stylesheet" type="text/css" />
  <link href="/css/webflow.css" rel="stylesheet" type="text/css" />
  <link href="/css/enova-a1e24a.webflow.css" rel="stylesheet" type="text/css" />
  <style set:html={`@media (min-width:992px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="e47a7df7-67d2-db7a-3d8b-ba1a50c385c1"] {display:none;-webkit-transform:translate3d(0, 10px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 10px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 10px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 10px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0;height:0px;}}@media (max-width:991px) and (min-width:768px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="e47a7df7-67d2-db7a-3d8b-ba1a50c385af"] {opacity:0;}html.w-mod-js:not(.w-mod-ix) [data-w-id="e47a7df7-67d2-db7a-3d8b-ba1a50c385c1"] {display:none;opacity:0;}}@media (max-width:767px) and (min-width:480px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="e47a7df7-67d2-db7a-3d8b-ba1a50c385af"] {opacity:0;}html.w-mod-js:not(.w-mod-ix) [data-w-id="e47a7df7-67d2-db7a-3d8b-ba1a50c385c1"] {display:none;opacity:0;}}@media (max-width:479px) {html.w-mod-js:not(.w-mod-ix) [data-w-id="e47a7df7-67d2-db7a-3d8b-ba1a50c385af"] {opacity:0;}html.w-mod-js:not(.w-mod-ix) [data-w-id="e47a7df7-67d2-db7a-3d8b-ba1a50c385c1"] {display:none;opacity:0;}}`}></style>
  <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

  <!-- Primary favicon (used by Google Search + browsers) -->
  <link rel="icon" type="image/png" href="/enova-favicon.png" sizes="any" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/enova-favicon.png" />

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>
<body class={bodyClass}>
  <div class="page-wrapper">
    <div class="global-styles">
      <div class="global-styles_default w-embed">
        <style set:html={`
  [tabindex]:not([tabindex='-1']):focus-visible,
  button:focus-visible,
  a:focus-visible,
  [role='button']:focus-visible,
  input[type='file']:focus-visible {
    outline: var(--_sizes---focus--width, 2px) solid var(--_theme---system--focus-state, #005fcc);
    outline-offset: var(--_sizes---focus--offset, 2px);
  }
  ::selection {
    background-color: var(--_theme---system--selection-background);
    color: var(--_theme---system--selection-text);
    text-shadow: none;
  }
  ::-moz-selection {
    background-color: var(--_theme---system--selection-background);
    color: var(--_theme---system--selection-text);
    text-shadow: none;
  }
  .w-richtext > :not(div):first-child,
  .w-richtext > div:first-child > :first-child {
    margin-top: 0 !important;
  }
  .w-richtext > :last-child,
  .w-richtext ul li:last-child,
  .w-richtext ol li:last-child {
    margin-bottom: 0 !important;
  }
  .text-style-3lines { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
  .text-style-2lines { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .text-style-1line { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
`}></style>
      </div>
    </div>
    <Nav />
    <main class="main-wrapper">
      <slot />
    </main>
  </div>
  <script is:inline src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6a576e7b50f1df5088dda25d" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script is:inline src="/js/webflow.js"></script>
</body>
</html>
